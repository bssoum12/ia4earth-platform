# ============================================================
# IA4EARTH Startup Challenge — Variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# Ne JAMAIS committer .env.local en production.   
# ============================================================

# ------ Supabase ------
# URL de votre projet Supabase (visible dans Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# Clé anon/public (sûre côté client — permissions controlées par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service_role (STRICTEMENT côté serveur — ne jamais exposer au client)
# Utilisée dans les API routes pour bypasser la RLS lors des insertions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------ Resend ------
# Clé API Resend pour les e-mails transactionnels
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditeur (doit être un domaine vérifié dans Resend)
FROM_EMAIL=IA4EARTH Challenge <noreply@ia4earth.tn>

# Adresse reply-to (destinataire des réponses des candidats)
REPLY_TO_EMAIL=contact@ia4earth.tn

# ------ App ------
# URL publique de l'application (pour les liens dans les e-mails)
NEXT_PUBLIC_APP_URL=https://candidatures.ia4earth.tn

# ------ Administration ------
# Mot de passe administrateur (hashé en SHA-256 et comparé côté serveur)
# Choisir un mot de passe fort — ex: openssl rand -base64 32
ADMIN_SECRET=change-me-with-a-strong-password
